{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "rootDir": "..",
    "outDir": "dist",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "../app/lib/audit.mjs", "../app/lib/shopify-catalog.server.mjs"]
}
